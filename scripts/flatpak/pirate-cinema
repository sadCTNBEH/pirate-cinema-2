#!/bin/sh
set -eu

# The PyQt BaseApp uses a versioned site-packages directory linked here.
export PYTHONPATH=/app/lib/python/site-packages:/app/lib/pirate-cinema-python
export PIRATE_CINEMA_QT_RUNTIME_SELECTED=flatpak
export PYTHONNOUSERSITE=1
cd /app/share/pirate-cinema
case "${1:-}" in
    --flatpak-diagnostics) shift; exec python3 diagnostics.py "$@" ;;
    --smoke-test|--smoke-test-mpv|--smoke-test-webengine|--animego-worker) exec python3 run.py "$@" ;;
    *) exec python3 desktop.py "$@" ;;
esac
